.page{min-height:100vh}.hero{height:530rpx;padding:88rpx 50rpx 0;color:#fff;background:linear-gradient(155deg,#126f5a,#06483e);position:relative;overflow:hidden}.hero:after{content:"";position:absolute;width:650rpx;height:650rpx;border-radius:50%;border:1rpx solid rgba(255,255,255,.08);right:-360rpx;top:-160rpx;box-shadow:0 0 0 80rpx rgba(255,255,255,.025),0 0 0 160rpx rgba(255,255,255,.02)}.nav{display:flex;align-items:center;gap:18rpx;font-size:31rpx;font-weight:600;position:relative;z-index:2}.logo{width:62rpx;height:62rpx;border-radius:18rpx;background:#d4a94f;display:flex;align-items:center;justify-content:center;font-size:34rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.18)}.hero-small{display:block;margin-top:62rpx;color:#a6d1c5;font-size:20rpx;letter-spacing:4rpx}.hero-title{white-space:pre-line;font-size:47rpx;font-weight:700;line-height:1.42;margin-top:18rpx;letter-spacing:2rpx}.hero-desc{display:block;margin-top:20rpx;color:#c4ddd7;font-size:26rpx}.leaf{position:absolute;border-radius:100% 0 100% 0;border:1rpx solid rgba(255,255,255,.1);transform:rotate(25deg)}.leaf-one{width:140rpx;height:230rpx;right:70rpx;bottom:25rpx}.leaf-two{width:80rpx;height:140rpx;right:185rpx;bottom:-15rpx}.query{margin:-54rpx 32rpx 0;padding:44rpx 36rpx 36rpx;position:relative;z-index:3;text-align:center}.query-icon{margin:-80rpx auto 20rpx;width:74rpx;height:74rpx;line-height:70rpx;border-radius:24rpx;background:#f3e6c8;color:#9c762f;font-size:46rpx;border:7rpx solid #fff}.query-title{font-weight:700;font-size:36rpx}.query-sub{font-size:24rpx;color:#8a9892;margin:12rpx 0 34rpx}.field{height:100rpx;border:2rpx solid #e4ebe7;border-radius:18rpx;display:flex;align-items:center;padding:0 25rpx;margin-bottom:25rpx;text-align:left}.field.active{border-color:#25816b;background:#fafffd}.field>text{font-size:27rpx;font-weight:600;padding-right:22rpx;border-right:1rpx solid #dce4e0}.field input{font-size:30rpx;flex:1;margin-left:22rpx}.placeholder{font-size:27rpx;color:#acb6b1}.check{width:38rpx;height:38rpx;border-radius:50%;background:#e1f2ec;color:#108361;text-align:center;line-height:38rpx;font-weight:700}.privacy{font-size:21rpx;color:#98a39e;margin-top:26rpx}.privacy text{color:#168061;font-size:14rpx}.steps{display:flex;align-items:center;justify-content:center;margin:54rpx 50rpx 0}.steps view{display:flex;flex-direction:column;align-items:center;gap:12rpx;color:#65766f;font-size:22rpx}.steps i{font-style:normal;width:54rpx;height:54rpx;border-radius:50%;background:#e5f1ed;color:#146d58;display:flex;align-items:center;justify-content:center;font-weight:700}.steps b{width:70rpx;height:2rpx;background:#d4dfdb;margin:0 12rpx 35rpx}.help{text-align:center;color:#a0aaa6;font-size:22rpx;margin-top:45rpx}
